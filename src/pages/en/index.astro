---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.order - b.data.order).slice(0, 2);
const insights = (await getCollection('insights')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const home = (await getCollection('settings')).find(s => s.id === 'home')!.data;
---
<BaseLayout
  lang="en"
  title="Strategic Marketing Consultant"
  description="Strategy, positioning and business growth. Nuria Morales, strategic marketing consultant for businesses that want to move forward with direction."
>
  <!-- 01 HERO -->
  <section class="hero">
    <div class="hero__photo">
      <div class="hero__photo-caption">
        <p class="eyebrow">Strategic Marketing Consultant</p>
      </div>
      <img src={home.heroImage} alt="Nuria Morales" class="hero__photo-img" />
    </div>
    <div class="hero__statement-block">
      <div class="wrap">
        <h1 class="display hero__title">NURIA MORALES</h1>
        <p class="hero__claim">Before doing more marketing, you need to understand the business better.</p>
        <div class="hero__actions">
          <a href="/en/contacto" class="btn">Let's talk</a>
          <a href="/en/consultoria" class="btn">Explore my approach</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 POSITIONING STATEMENT -->
  <section class="section statement">
    <div class="wrap">
      <p class="display statement__text">Marketing doesn't start on Instagram.<br />It starts by understanding the business.</p>
    </div>
  </section>

  <!-- 03 PROBLEM / INSIGHT -->
  <section class="section section--beige">
    <div class="wrap grid-2">
      <div>
        <SectionHeading number="03" eyebrow="The real problem" title="Maybe your problem isn't doing more marketing." />
      </div>
      <div>
        <p>Maybe it's not being clear on what your marketing should be doing — and for whom, and why now and not any other way. That's where this work begins.</p>
      </div>
    </div>
  </section>

  <!-- 04 WHO IS NURIA -->
  <section class="section">
    <div class="wrap grid-asym">
      <div>
        <SectionHeading number="04" eyebrow="About" title="Before asking what to publish, I care about understanding what the brand should mean." />
        <p>I work with businesses that want to genuinely differentiate themselves, not just look different for one quarter. My starting point is always the business: model, customer, positioning, value proposition — marketing comes after, as a consequence, not a patch.</p>
        <a href="/en/sobre-mi" class="btn">About →</a>
      </div>
      <div class="hero__placeholder">[NURIA PORTRAIT — ABOUT]</div>
    </div>
  </section>

  <!-- 05 WHAT I DO -->
  <section class="section section--beige">
    <div class="wrap">
      <SectionHeading number="05" eyebrow="What I do" title="Four territories. One starting point: the business." />
      <div class="territories">
        <div class="territories__item">
          <p class="eyebrow">01</p>
          <h3 class="display">Strategic Diagnosis</h3>
          <p>Clarity on the real problem, priorities and opportunities before deciding anything.</p>
        </div>
        <div class="territories__item">
          <p class="eyebrow">02</p>
          <h3 class="display">Brand Positioning</h3>
          <p>What place the brand should occupy and why it should be chosen over real competitors.</p>
        </div>
        <div class="territories__item">
          <p class="eyebrow">03</p>
          <h3 class="display">Growth Strategy</h3>
          <p>Where value is being lost in the customer journey and which levers drive growth.</p>
        </div>
        <div class="territories__item">
          <p class="eyebrow">04</p>
          <h3 class="display">AI Search Visibility</h3>
          <p>How the brand is discovered and understood across search engines and generative AI systems.</p>
        </div>
      </div>
      <a href="/en/consultoria" class="btn">See full consulting →</a>
    </div>
  </section>

  <!-- 06/07 METHODOLOGY -->
  <section class="section section--dark">
    <div class="wrap">
      <SectionHeading dark number="07" eyebrow="Methodology" title="A consulting system, not a list of services." />
      <div class="method">
        <div><p class="eyebrow">01</p><p class="label" style="color:var(--white)">Understand</p></div>
        <div><p class="eyebrow">02</p><p class="label" style="color:var(--white)">Diagnose</p></div>
        <div><p class="eyebrow">03</p><p class="label" style="color:var(--white)">Strategize</p></div>
        <div><p class="eyebrow">04</p><p class="label" style="color:var(--white)">Activate</p></div>
      </div>
      <a href="/en/metodologia" class="btn btn--dark">See full methodology →</a>
    </div>
  </section>

  <!-- 08 SELECTED WORK -->
  {proyectos.length > 0 ? (
    <section class="section">
      <div class="wrap">
        <SectionHeading number="08" eyebrow="Selected Work" title="Real projects, verifiable judgment." />
        {proyectos.map(p => (
          <ProjectCard
            href={`/en/proyectos/${p.id}`}
            title={p.data.title}
            sector={p.data.sector}
            type={p.data.type}
            summary={p.data.summary}
          />
        ))}
        <a href="/en/proyectos" class="btn" style="margin-top:24px;display:inline-block">See all projects →</a>
      </div>
    </section>
  ) : (
    <section class="section selected-work-empty">
      <div class="wrap">
        <p class="eyebrow">08 — Selected Work</p>
        <p class="selected-work-empty__text">A growing collection of strategic projects.</p>
      </div>
    </section>
  )}

  <!-- 09 AI SEARCH -->
  <section class="section section--beige">
    <div class="wrap grid-2">
      <div>
        <SectionHeading number="09" eyebrow="The future of search" title="How brands get discovered when the one searching is an AI." />
        <p>The way a potential customer finds and evaluates a brand is changing. AI Search Visibility is the work of making sure a brand is understood, cited and correctly considered in these new environments — no guaranteed-ranking promises, real work underneath.</p>
        <a href="/en/consultoria/ai-search" class="btn">AI Search Visibility →</a>
      </div>
      <div class="hero__placeholder">[PROJECT IMAGE]</div>
    </div>
  </section>

  <!-- 10 INSIGHTS -->
  <section class="section">
    <div class="wrap">
      <SectionHeading number="10" eyebrow="Insights" title="Analysis, not filler content." />
      {insights.map(a => (
        <ArticleCard
          href={`/en/insights/${a.id}`}
          title={a.data.title}
          category={a.data.category}
          date={a.data.date.toISOString()}
          excerpt={a.data.excerpt}
        />
      ))}
      <a href="/en/insights" class="btn" style="margin-top:24px;display:inline-block">See all Insights →</a>
    </div>
  </section>

  <!-- 11 CREDENTIALS -->
  <section class="section section--beige credentials">
    <div class="wrap">
      <SectionHeading number="11" eyebrow="Background" title="Credentials, not a wall of diplomas." />
      <ul class="credentials__list">
        <li>University degree in Marketing.</li>
        <li>Specialization in Business Marketing Strategy and Business Strategy.</li>
        <li>Accreditation as Strategic Business Consultant — American Business School of Miami.</li>
      </ul>
    </div>
  </section>

  <!-- 12 NEWSLETTER -->
  <section class="section newsletter">
    <div class="wrap grid-2">
      <div>
        <SectionHeading number="12" eyebrow="The Strategic Note" title="Ideas, analysis and trends — no noise." />
        <p>A curated selection of ideas, analysis and trends on marketing, business and AI. Coming soon.</p>
      </div>
      <form class="newsletter__form" aria-label="Subscribe to The Strategic Note">
        <label for="email" class="label">Email</label>
        <input id="email" type="email" name="email" placeholder="you@email.com" required />
        <button type="submit" class="btn">Subscribe →</button>
      </form>
    </div>
  </section>

  <!-- 13 FINAL CTA -->
  <section class="section section--dark final-cta">
    <div class="wrap">
      <p class="display final-cta__text">If you're looking for a strategic perspective to understand where you stand, spot opportunities and decide what to do next, let's talk.</p>
      <a href="/en/contacto" class="btn btn--dark">Start a conversation →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: var(--white);
  }
  .hero__photo {
    position: relative;
    width: 100%;
    height: 78vh;
    min-height: 480px;
    max-height: 760px;
    overflow: hidden;
    margin-top: -1px;
    background: var(--dark);
  }
  .hero__photo-img {
    position: absolute;
    top: 0;
    right: 0;
    width: 42%;
    min-width: 320px;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
  }
  @media (max-width: 640px) {
    .hero__photo-img { width: 100%; min-width: 0; object-position: center 15%; }
  }
  .hero__photo-caption {
    position: absolute;
    left: var(--gutter);
    bottom: 28px;
  }
  .hero__photo-caption .eyebrow {
    color: var(--white);
    text-shadow: 0 1px 12px rgba(0,0,0,0.35);
  }
  .hero__statement-block {
    background: var(--rosa-petalo);
    padding: clamp(48px, 7vw, 88px) 0;
  }
  .hero__title { font-size: clamp(38px, 6vw, 76px); margin: 0 0 24px; color: var(--dark); max-width: 780px; }
  .hero__claim { font-size: clamp(18px, 2vw, 22px); margin-bottom: 36px; max-width: 560px; }
  .hero__actions { display: flex; flex-wrap: wrap; }
  .hero__actions > a { margin-right: 32px; margin-bottom: 12px; }
  @media (max-width: 640px) {
    .hero__photo { height: 62vh; }
  }

  .statement__text {
    font-size: clamp(30px, 5.5vw, 60px);
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero__placeholder {
    aspect-ratio: 4/5;
    background: var(--beige);
    border: 1px dashed rgba(44,44,44,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(44,44,44,0.5);
    text-align: center;
    padding: 24px;
  }

  .territories {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    margin-bottom: 48px;
  }
  .territories__item h3 { font-size: 22px; margin: 10px 0; }
  @media (max-width: 900px) { .territories { grid-template-columns: repeat(2, 1fr); } }

  .method {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 40px 0;
  }
  @media (max-width: 720px) { .method { grid-template-columns: repeat(2, 1fr); } }

  .credentials__list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 640px;
  }
  .credentials__list li {
    padding-top: 16px;
    border-top: 1px solid rgba(44,44,44,0.15);
  }

  .newsletter__form { display: flex; flex-direction: column; gap: 14px; max-width: 360px; }
  .newsletter__form input {
    font-family: var(--font-body);
    font-size: 16px;
    padding: 12px 0;
    border: none;
    border-bottom: 1px solid var(--dark);
    background: transparent;
  }
  .newsletter__form input:focus { outline: none; border-bottom-color: var(--gold); }
  .newsletter__form button { background: none; border-bottom: 1px solid var(--dark); cursor: pointer; align-self: flex-start; }

  .final-cta__text { font-size: clamp(26px, 4vw, 42px); max-width: 820px; margin-bottom: 40px; }

  .selected-work-empty { text-align: center; }
  .selected-work-empty__text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 28px);
    color: rgba(44,44,44,0.6);
    margin-top: 16px;
  }
</style>
