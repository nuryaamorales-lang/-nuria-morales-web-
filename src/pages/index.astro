---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.order - b.data.order).slice(0, 2);
const insights = (await getCollection('insights')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const home = (await getCollection('settings')).find(s => s.id === 'home')!.data;
---
<BaseLayout
  title="Consultora Estratégica de Marketing"
  description="Estrategia, posicionamiento y crecimiento empresarial. Nuria Morales, consultora estratégica de marketing especializada en negocios que quieren avanzar con dirección."
>
  <!-- 01 HERO -->
  <section class="hero">
    <div class="hero__bg" style={`background-image:url('${home.heroImage}')`}></div>
    <div class="hero__overlay"></div>
    <div class="hero__scrim-top"></div>
    <div class="hero__scrim-bottom"></div>
    <div class="wrap hero__inner">
      <p class="eyebrow">{home.eyebrow}</p>
      <h1 class="display hero__title">{home.heroTitle}</h1>
      <p class="hero__claim">{home.heroClaim}</p>
      <div class="hero__actions">
        <a href="/contacto" class="btn btn--dark">Hablemos</a>
        <a href="/consultoria" class="btn btn--dark">Explorar mi enfoque</a>
      </div>
    </div>
  </section>

  <!-- 02 POSITIONING STATEMENT -->
  <section class="section statement">
    <div class="wrap">
      <p class="display statement__text">{home.statementLine1}<br />{home.statementLine2}</p>
    </div>
  </section>

  <!-- 03 PROBLEM / INSIGHT -->
  <section class="section section--beige">
    <div class="wrap grid-2">
      <div>
        <SectionHeading number="03" eyebrow="El problema real" title={home.problemTitle} />
      </div>
      <div>
        <p>{home.problemBody}</p>
      </div>
    </div>
  </section>

  <!-- 04 WHO IS NURIA -->
  <section class="section">
    <div class="wrap grid-asym">
      <div>
        <SectionHeading number="04" eyebrow="Sobre mí" title={home.aboutTitle} />
        <p>{home.aboutBody}</p>
        <a href="/sobre-mi" class="btn">Sobre mí →</a>
      </div>
      <div class="hero__placeholder">[NURIA PORTRAIT — ABOUT]</div>
    </div>
  </section>

  <!-- 05 WHAT I DO -->
  <section class="section section--beige">
    <div class="wrap">
      <SectionHeading number="05" eyebrow="Qué hago" title="Cuatro territorios de trabajo." />
      <div class="territories">
        <div class="territories__item">
          <p class="eyebrow">01</p>
          <h3 class="display">Strategy</h3>
          <p>Diagnóstico de negocio, modelo y prioridades antes de cualquier acción de marketing.</p>
        </div>
        <div class="territories__item">
          <p class="eyebrow">02</p>
          <h3 class="display">Positioning &amp; Branding</h3>
          <p>Qué debe significar la marca y cómo se percibe frente a la competencia real.</p>
        </div>
        <div class="territories__item">
          <p class="eyebrow">03</p>
          <h3 class="display">Growth &amp; Customer Journey</h3>
          <p>Del primer contacto a la conversión: qué recorrido necesita cada tipo de cliente.</p>
        </div>
        <div class="territories__item">
          <p class="eyebrow">04</p>
          <h3 class="display">AI &amp; Search</h3>
          <p>Visibilidad de marca en búsqueda tradicional y en entornos de búsqueda generativa.</p>
        </div>
      </div>
      <a href="/consultoria" class="btn">Ver consultoría completa →</a>
    </div>
  </section>

  <!-- 06/07 METHODOLOGY -->
  <section class="section section--dark">
    <div class="wrap">
      <SectionHeading dark number="07" eyebrow="Metodología" title="Un sistema de consultoría, no una lista de servicios." />
      <div class="method">
        <div><p class="eyebrow">01</p><p class="label" style="color:var(--white)">Understand</p></div>
        <div><p class="eyebrow">02</p><p class="label" style="color:var(--white)">Diagnose</p></div>
        <div><p class="eyebrow">03</p><p class="label" style="color:var(--white)">Strategize</p></div>
        <div><p class="eyebrow">04</p><p class="label" style="color:var(--white)">Activate</p></div>
      </div>
      <a href="/metodologia" class="btn btn--dark">Ver metodología completa →</a>
    </div>
  </section>

  <!-- 08 SELECTED WORK -->
  <section class="section">
    <div class="wrap">
      <SectionHeading number="08" eyebrow="Selected Work" title="Proyectos reales, criterio verificable." />
      {proyectos.map(p => (
        <ProjectCard
          href={`/proyectos/${p.id}`}
          title={p.data.title}
          sector={p.data.sector}
          type={p.data.type}
          summary={p.data.summary}
        />
      ))}
      <a href="/proyectos" class="btn" style="margin-top:24px;display:inline-block">Ver todos los proyectos →</a>
    </div>
  </section>

  <!-- 09 AI SEARCH -->
  <section class="section section--beige">
    <div class="wrap grid-2">
      <div>
        <SectionHeading number="09" eyebrow="El futuro de la búsqueda" title="Cómo se descubren las marcas cuando quien busca es una IA." />
        <p>La forma en que un cliente potencial encuentra y evalúa una marca está cambiando. AI Search Visibility es el trabajo de asegurarse de que una marca se entiende, se cita y se considera correctamente en esos nuevos entornos — sin promesas de posición garantizada, con trabajo real de fondo.</p>
        <a href="/consultoria/ai-search" class="btn">AI Search Visibility →</a>
      </div>
      <div class="hero__placeholder">[PROJECT IMAGE]</div>
    </div>
  </section>

  <!-- 10 INSIGHTS -->
  <section class="section">
    <div class="wrap">
      <SectionHeading number="10" eyebrow="Insights" title="Análisis, no contenido de relleno." />
      {insights.map(a => (
        <ArticleCard
          href={`/insights/${a.id}`}
          title={a.data.title}
          category={a.data.category}
          date={a.data.date.toISOString()}
          excerpt={a.data.excerpt}
        />
      ))}
      <a href="/insights" class="btn" style="margin-top:24px;display:inline-block">Ver todos los Insights →</a>
    </div>
  </section>

  <!-- 11 CREDENTIALS -->
  <section class="section section--beige credentials">
    <div class="wrap">
      <SectionHeading number="11" eyebrow="Formación" title="Credenciales, no un muro de diplomas." />
      <ul class="credentials__list">
        <li>Formación universitaria en Marketing.</li>
        <li>Especialización en Business Marketing Strategy y Estrategia de Negocios.</li>
        <li>Acreditación como Consultora Estratégica de Negocios — American Business School of Miami.</li>
      </ul>
    </div>
  </section>

  <!-- 12 NEWSLETTER -->
  <section class="section newsletter">
    <div class="wrap grid-2">
      <div>
        <SectionHeading number="12" eyebrow="The Strategic Note" title="Ideas, análisis y tendencias — sin ruido." />
        <p>Una selección de ideas, análisis y tendencias sobre marketing, negocios e IA. Próximamente.</p>
      </div>
      <form class="newsletter__form" aria-label="Suscripción a The Strategic Note">
        <label for="email" class="label">Email</label>
        <input id="email" type="email" name="email" placeholder="tu@email.com" required />
        <button type="submit" class="btn">Suscribirme →</button>
      </form>
    </div>
  </section>

  <!-- 13 FINAL CTA -->
  <section class="section section--dark final-cta">
    <div class="wrap">
      <p class="display final-cta__text">{home.finalCtaText}</p>
      <a href="/contacto" class="btn btn--dark">Iniciar conversación →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: clamp(140px, 20vw, 260px) 0 clamp(90px, 12vw, 160px);
    overflow: hidden;
    min-height: 920px;
    display: flex;
    align-items: flex-end;
  }
  .hero__bg {
    position: absolute;
    top: 0; right: 0; bottom: 0; left: 0;
    background-size: cover;
    background-position: 88% 42%;
    filter: brightness(0.78) saturate(0.85);
    z-index: 0;
  }
  .hero__overlay {
    position: absolute;
    top: 0; right: 0; bottom: 0; left: 0;
    background: rgba(28,26,24,0.32);
    z-index: 1;
  }
  .hero__scrim-top {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 380px;
    background: linear-gradient(to bottom, rgba(246,216,228,0.9), rgba(246,216,228,0));
    z-index: 1;
  }
  .hero__scrim-bottom {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 480px;
    background: linear-gradient(to top, rgba(28,26,24,0.94), rgba(28,26,24,0));
    z-index: 1;
  }
  .hero__inner { position: relative; z-index: 2; max-width: 820px; }
  .hero__title { font-size: clamp(48px, 9vw, 108px); margin: 16px 0 28px; color: var(--white); }
  .hero__claim { font-size: clamp(18px, 2vw, 22px); max-width: 520px; margin-bottom: 40px; color: var(--white); }
  .hero__actions { display: flex; flex-wrap: wrap; }
  .hero__actions > a { margin-right: 32px; margin-bottom: 12px; }

  .statement__text {
    font-size: clamp(30px, 5.5vw, 60px);
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero__placeholder {
    aspect-ratio: 4/5;
    background: var(--beige);
    border: 1px dashed rgba(44,44,44,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(44,44,44,0.5);
    text-align: center;
    padding: 24px;
  }

  .territories {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    margin-bottom: 48px;
  }
  .territories__item h3 { font-size: 22px; margin: 10px 0; }
  @media (max-width: 900px) { .territories { grid-template-columns: repeat(2, 1fr); } }

  .method {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 40px 0;
  }
  @media (max-width: 720px) { .method { grid-template-columns: repeat(2, 1fr); } }

  .credentials__list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 640px;
  }
  .credentials__list li {
    padding-top: 16px;
    border-top: 1px solid rgba(44,44,44,0.15);
  }

  .newsletter__form { display: flex; flex-direction: column; gap: 14px; max-width: 360px; }
  .newsletter__form input {
    font-family: var(--font-body);
    font-size: 16px;
    padding: 12px 0;
    border: none;
    border-bottom: 1px solid var(--dark);
    background: transparent;
  }
  .newsletter__form input:focus { outline: none; border-bottom-color: var(--gold); }
  .newsletter__form button { background: none; border-bottom: 1px solid var(--dark); cursor: pointer; align-self: flex-start; }

  .final-cta__text { font-size: clamp(26px, 4vw, 42px); max-width: 820px; margin-bottom: 40px; }
</style>
