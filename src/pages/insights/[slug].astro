---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const insights = await getCollection('insights');
  return insights.map(a => ({ params: { slug: a.id }, props: { entry: a } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const formatted = entry.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": entry.data.title,
  "datePublished": entry.data.date.toISOString(),
  "author": { "@type": "Person", "name": "Nuria Morales" },
};
---
<BaseLayout title={entry.data.title} description={entry.data.metaDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <article class="section" style="padding-top: 100px">
    <div class="wrap">
      <p class="label" style="color: var(--gold)">{entry.data.category} · {formatted}</p>
      <h1 class="display" style="font-size: clamp(32px, 5.5vw, 56px); margin: 16px 0 8px">{entry.data.title}</h1>
      {entry.data.subtitle && <p class="article-subtitle">{entry.data.subtitle}</p>}
      <div class="prose">
        <Content />
      </div>
      {entry.data.servicioRelacionado && (
        <a href="/consultoria" class="btn" style="margin-top: 32px; display: inline-block">Ver servicio relacionado: {entry.data.servicioRelacionado} →</a>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .article-subtitle { max-width: 640px; margin: 8px 0 40px; font-size: 19px; color: rgba(44,44,44,0.75); }
  .prose { max-width: 720px; }
  .prose :global(h2) { font-size: 26px; margin: 40px 0 12px; }
  .prose :global(p) { margin: 0 0 16px; }
</style>
