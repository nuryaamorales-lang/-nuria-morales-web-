---
import { getCollection } from 'astro:content';
const year = new Date().getFullYear();
const contacto = (await getCollection('contacto'))[0].data;

interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;

const t = {
  es: {
    role: 'Consultora Estratégica de Marketing',
    nav: [
      { href: '/sobre-mi', label: 'About' },
      { href: '/consultoria', label: 'Consulting' },
      { href: '/proyectos', label: 'Selected Work' },
      { href: '/insights', label: 'Insights' },
    ],
    email: 'Email',
    rights: `© ${year} Nuria Morales. Todos los derechos reservados.`,
    privacy: 'Privacy Policy',
    cookies: 'Cookies',
    legal: 'Legal Notice',
    privacyHref: '/legal/privacy',
    cookiesHref: '/legal/cookies',
    legalHref: '/legal/legal',
  },
  en: {
    role: 'Strategic Marketing Consultant',
    nav: [
      { href: '/en/sobre-mi', label: 'About' },
      { href: '/en/consultoria', label: 'Consulting' },
      { href: '/en/proyectos', label: 'Selected Work' },
      { href: '/en/insights', label: 'Insights' },
    ],
    email: 'Email',
    rights: `© ${year} Nuria Morales. All rights reserved.`,
    privacy: 'Privacy Policy',
    cookies: 'Cookies',
    legal: 'Legal Notice',
    privacyHref: '/legal/privacy',
    cookiesHref: '/legal/cookies',
    legalHref: '/legal/legal',
  },
}[lang];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__top">
      <div>
        <p class="display site-footer__name">NURIA MORALES</p>
        <p class="label" style="color: var(--rosa-petalo)">{t.role}</p>
      </div>
      <nav aria-label="Footer navigation" class="site-footer__nav">
        <ul>
          {t.nav.map(link => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
      <div class="site-footer__social">
        {contacto.linkedin && <a href={contacto.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
        {contacto.instagram && <a href={contacto.instagram} target="_blank" rel="noopener">Instagram</a>}
        <a href={`mailto:${contacto.email}`}>{t.email}</a>
      </div>
    </div>
    <hr class="rule" />
    <div class="site-footer__bottom">
      <p>{t.rights}</p>
      <div class="site-footer__legal">
        <a href={t.privacyHref}>{t.privacy}</a>
        <a href={t.cookiesHref}>{t.cookies}</a>
        <a href={t.legalHref}>{t.legal}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    color: var(--white);
    padding: 72px 0 32px;
  }
  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    justify-content: space-between;
    padding-bottom: 48px;
  }
  .site-footer__name { font-size: 28px; margin-bottom: 6px; }
  .site-footer__nav ul, .site-footer__social {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
  }
  .site-footer__nav a, .site-footer__social a {
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--white);
    opacity: 0.85;
  }
  .site-footer__nav a:hover, .site-footer__social a:hover { opacity: 1; color: var(--rosa-petalo); }
  .site-footer .rule { border-top-color: rgba(255,255,255,0.18); margin: 0 0 24px; }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    font-size: 12px;
    opacity: 0.65;
  }
  .site-footer__legal { display: flex; gap: 20px; }
  .site-footer__legal a { color: var(--white); text-decoration: none; }
</style>
