---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; }
const { title } = Astro.props;
---
<BaseLayout title={title} description={`${title} — Nuria Morales`}>
  <section class="section" style="padding-top: 100px; max-width: 720px; margin: 0 auto;">
    <div class="wrap">
      <h1 class="display" style="font-size: clamp(28px,4vw,40px); margin-bottom: 24px">{title}</h1>
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .prose :global(p) { margin: 0 0 16px; }
</style>
