---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  lang?: 'es' | 'en';
}

const { title, description, image = '/images/og-default.jpg', lang = 'es' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Nuria Morales",
  "jobTitle": "Consultora Estratégica de Marketing",
  "url": Astro.site?.toString(),
  "worksFor": {
    "@type": "ProfessionalService",
    "name": "Nuria Morales — Consultoría Estratégica"
  }
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{title} — Nuria Morales</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — Nuria Morales`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Nuria Morales`} />
    <meta name="twitter:description" content={description} />

    <script>
      if (window.location.hash && window.location.hash.match(/access_token|error|confirmation_token|recovery_token|invite_token/)) {
        window.location.href = '/admin/' + window.location.hash;
      }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <a href="#main" class="sr-only">Saltar al contenido</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
